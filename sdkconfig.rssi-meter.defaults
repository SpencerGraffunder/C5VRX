# Standalone ~1 kHz RSSI meter (no video). See docs/rssi-meter.md.
CONFIG_C5VRX_RSSI_METER=y
CONFIG_C5VRX_PHY_PHASE_TAP_PROBE=n
CONFIG_C5VRX_BS_RELATIVE_WORKER_PROBE=n
CONFIG_C5VRX_BS_RELATIVE_MIDDLE_PROBE=n
CONFIG_C5VRX_BS_ADDCTIA_PROBE=n
CONFIG_C5VRX_PHASE8_HR_LIVE_TEST=n
CONFIG_C5VRX_PHASE5_360_LIVE=n
